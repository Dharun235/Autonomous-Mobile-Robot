<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Compact forward RGB camera. This is a proposed mount; no support bracket is modeled. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.03" />
      <origin xyz="0 0 0" />
      <inertia ixx="1.0e-5" ixy="0" ixz="0"
               iyy="1.0e-5" iyz="0" izz="1.0e-5" />
    </inertial>
    <visual>
      <origin xyz="-0.008 0 0" />
      <geometry><box size="0.045 0.052 0.026" /></geometry>
      <material name="camera_housing"><color rgba="0.12 0.12 0.14 1" /></material>
    </visual>
    <!-- Short shelf sits on the chassis front edge and supports the camera housing. -->
    <visual>
      <origin xyz="-0.0375 0 -0.017" />
      <geometry><box size="0.035 0.036 0.008" /></geometry>
      <material name="camera_mount"><color rgba="0.28 0.29 0.31 1" /></material>
    </visual>
    <visual>
      <origin xyz="0.016 0 0" rpy="0 ${pi/2} 0" />
      <geometry><cylinder radius="0.008" length="0.008" /></geometry>
      <material name="camera_lens"><color rgba="0.02 0.02 0.03 1" /></material>
    </visual>
    <collision>
      <origin xyz="-0.008 0 0" />
      <geometry><box size="0.045 0.052 0.026" /></geometry>
    </collision>
  </link>

  <!-- Camera housing center is 105 mm forward and 85 mm above base_link. -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.105 0 0.085" rpy="0 0.12 0" />
  </joint>

  <!-- ROS optical convention: +Z forward, +X right, +Y down. -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0.016 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- Gazebo camera publishes RGB and calibration on Gazebo Transport topics. -->
  <gazebo reference="camera_link">
    <sensor name="front_rgb_camera" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>
      <pose>0.016 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="front_rgb_camera">
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.10</near><far>8.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
