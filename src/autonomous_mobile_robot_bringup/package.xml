<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomous_mobile_robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for Autonomous Mobile Robot simulation and hardware</description>
  <maintainer email="dharunkumar.senthilkumar9@gmail.com">Dharun235</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autonomous_mobile_robot_description</exec_depend>
  <exec_depend>autonomous_mobile_robot_localization</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
